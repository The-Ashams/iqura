    "phrases": [
      "كَانَ الْبَرْدُ كَثِيرًا فِي الْجِبَالِ، وَكَانَ الطَّرِيقُ طَوِيلًا.",
      "مَشَى زِيَادٌ وَبَاسِمٌ وَتَاجِرَانِ مِنَ الْجَبَلِ إِلَى الْقَرْيَةِ.",
      "كَانَ التَّاجِرَانِ يَحْمِلَانِ أَكْيَاسًا ثَقِيلَةً.",
      "قَالَ بَاسِمٌ: « أُرِيدُ أَنْ أَصِلَ إِلَى الْقَرْيَةِ قَبْلَ الْمَسَاءِ. »",
      "قَالَ زِيَادٌ: « لَا تَتَعَجَّلْ. الطَّرِيقُ صَعْبٌ، وَالْجِسْرُ بَعِيدٌ. »",
      "عِنْدَ الْجِسْرِ، رَأَى زِيَادٌ بَابًا قَدِيمًا، وَعَلَى الْبَابِ كَلِمَاتٌ.",
      "قَرَأَ زِيَادٌ الْكَلِمَاتِ: « لَا تَتَعَجَّلْ، وَلَا تُسَافِرْ فِي الْمَسَاءِ. »",
      "لَمْ يَفْهَمْ بَاسِمٌ كَلِمَةَ « تَتَعَجَّلْ »، وَسَأَلَ زِيَادًا عَنْهَا.",
      "عَرَفَ زِيَادٌ الْحُرُوفَ: ع ج ل، وَقَالَ: « التَّعَجُّلُ خَطَأٌ. »",
      "قَالَ زِيَادٌ: « الْحُرُوفُ تُسَاعِدُنَا، لَٰكِنَّ الْمَعْنَى فِي الْكِتَابِ. »",
      "فَرِحَ بَاسِمٌ، وَقَالَ: « أُرِيدُ أَنْ أَتَعَلَّمَ الْحُرُوفَ. »",
      "بَاتَ الْمُسَافِرُونَ فِي خَيْمَةٍ عِنْدَ الْجِسْرِ.",
      "فِي الْخَيْمَةِ، تَكَلَّمَ الْمُسَافِرُونَ، وَتَذَكَّرَ زِيَادٌ قِصَصًا قَدِيمَةً.",
      "اسْتَمَعَ بَاسِمٌ إِلَى الْقِصَصِ، ثُمَّ نَامَ.",
      "فِي الْمَسَاءِ، وَقَعَ الثَّلْجُ عَلَى الْجَبَلِ.",
      "قَالَ بَاسِمٌ: « لَيْتَ الطَّرِيقَ قَصِيرٌ! »",
      "قَالَ تَاجِرٌ: « لَعَلَّ الْقَرْيَةَ قَرِيبَةٌ. »",
      "فِي الصَّبَاحِ، صَارَ الطَّرِيقُ أَبْيَضَ، وَكَانَ الْمَاءُ بَارِدًا.",
      "لَمْ يَنَمْ بَاسِمٌ كَثِيرًا، لَٰكِنَّ بَاسِمًا كَانَ سَعِيدًا.",
      "شَرِبَ الْمُسَافِرُونَ الْمَاءَ، وَأَكَلُوا الْخُبْزَ، وَحَمَلُوا الْأَكْيَاسَ.",
      "قَالَ زِيَادٌ: « يَا بَاسِمُ، لَا تَتَعَجَّلْ. الطَّرِيقُ أَبْيَضُ. »",
      "ثُمَّ مَشَى الْمُسَافِرُونَ إِلَى الْقَرْيَةِ، وَوَصَلُوا قَبْلَ الْمَسَاءِ.",
      "فِي السُّوقِ، لَقِيَ الْمُسَافِرُونَ أَبَا سَمِيرٍ، تَاجِرًا مِنْ بَغْدَادَ.",
      "دَعَا الْمُسَافِرِينَ أَبُو سَمِيرٍ إِلَى بَيْتِهِ.",
      "فِي بَيْتِ أَبِي سَمِيرٍ، جَلَسَ الضُّيُوفُ فِي الْمَجْلِسِ، وَتَعَارَفُوا.",
      "أَكْرَمَ أَبُو سَمِيرٍ الضُّيُوفَ، وَقَدَّمَ لَهُمُ الْخُبْزَ وَالتَّمْرَ.",
      "وَعَدَ أَبُو سَمِيرٍ بَاسِمًا أَنْ يَكْتُبَ لَهُ رِسَالَةً.",
      "سَأَلَ أَبُو سَمِيرٍ بَاسِمًا: « مَا تَعَلَّمْتَ فِي الطَّرِيقِ؟ »",
      "قَالَ بَاسِمٌ: « تَعَلَّمْتُ أَنْ أَقِفَ، وَأَنْ أَقْرَأَ، وَأَنْ أَسْأَلَ. »",
      "قَالَ بَاسِمٌ: « لَنْ أَنْسَى هَٰذِهِ الْقِصَّةَ. »",
