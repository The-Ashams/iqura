      "question": {
        "type": "qcm",
        "consigne": "Pourquoi dit-on فِيهِ, avec -hi ?",
        "choix": [
          "après ī, -hu devient -hi",
          "فِي est féminin",
          "-hi veut dire « à elle »"
        ],
        "reponse": 0,
        "explication": "Après i, ī ou ay, -hu devient -hi."
      }
    },
