    {
      "type": "regle",
      "titre": "Les pronoms collés",
      "texte": "Un petit pronom collé au nom lui fait perdre article et tanwīn : -ī mon, -ka ton (homme), -ki ton (femme), -hu son (à lui), -hā son (à elle), -nā notre. Le ة devient ت : إِبْرَتِي.",
      "exemples": [
        "ثَوْبِي",
        "ثَوْبُكَ",
        "ثَوْبُكِ",
        "ثَوْبُهُ",
        "ثَوْبُهَا",
        "ثَوْبُنَا",
        "إِبْرَتِي"
      ],
      "question": {
        "type": "qcm",
        "consigne": "Que veut dire ثَوْبُهَا ?",
        "choix": [
          "son vêtement (à elle)",
          "son vêtement (à lui)",
          "mon vêtement"
        ],
        "reponse": 0,
        "explication": "-hā : « à elle »."
      }
    },
    {
      "type": "regle",
      "titre": "Au pluriel",
      "texte": "Pour plusieurs : -kum votre (hommes), -kunna votre (femmes), -hum leur (à eux), -hunna leur (à elles) ; pour deux : -kumā votre, -humā leur. Retiens-les pour les reconnaître, tu les exerceras plus tard.",
