    {
      "type": "regle",
      "titre": "L'inaccompli",
      "texte": "L'inaccompli dit ce qui se fait maintenant ou d'habitude ; un préfixe dit qui agit, et la fin est -u : أَكْتُبُ (je), تَكْتُبُ (tu, ou elle), يَكْتُبُ (il). À une femme : تَكْتُبِينَ (fin en -īna).",
      "exemples": [
        "أَكْتُبُ",
        "تَكْتُبُ",
        "تَكْتُبِينَ",
        "يَكْتُبُ"
      ],
      "question": {
        "type": "qcm",
        "consigne": "Que veut dire « أَسْكُنُ » ?",
        "choix": [
          "j'habite",
          "il habite",
          "tu habites"
        ],
        "reponse": 0,
        "explication": "أَـ : « je »."
      }
    },
    {
      "type": "regle",
      "titre": "La voyelle du milieu",
