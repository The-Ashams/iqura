      "repliques": [
        {
          "qui": "samir_oasis",
          "texte": "Le soir, au jardin du conteur, on écoute des histoires et on fait des projets."
        },
        {
          "qui": "samir_oasis",
          "texte": "Pour dire ce qui se fera, il suffit d'ajouter un petit mot devant l'inaccompli."
        }
      ],
      "objectif": "Dire ce qui se fera demain."
    },
    {
      "type": "echauffement",
      "exercices": [
        {
          "type": "completer",
          "consigne": "Complète : « Je n'ai pas compris la question. »",
          "ar": "… فَهِمْتُ السُّؤَالَ.",
          "choix_ar": [
            "مَا",
            "لَا",
            "لَمْ"
          ],
          "reponse": 0,
          "explication": "Devant un passé : مَا (leçon 2.27)."
        },
        {
          "type": "traduire",
          "consigne": "Comment dit-on « nous écrivons » ?",
          "choix_ar": [
            "نَكْتُبُ",
            "كَتَبْنَا",
            "يَكْتُبُونَ"
          ],
          "reponse": 0,
          "explication": "نَـ : « nous », au présent (leçon 2.26)."
        },
        {
          "type": "qcm",
          "consigne": "Que veut dire « لَمْ يَرْجِعْ » ?",
          "choix": [
            "il n'est pas revenu",
            "il ne revient pas",
            "il reviendra"
          ],
          "reponse": 0,
          "explication": "لَمْ : sens passé (leçon 2.27)."
        }
      ]
    },
