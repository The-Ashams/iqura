        "أَوْلَادٌ",
        "أَبْوَابٌ",
        "رِجَالٌ",
        "جِبَالٌ",
        "ثِيَابٌ",
        "بُيُوتٌ",
        "خُيُوطٌ",
        "كُتُبٌ"
