    {
      "type": "regle",
      "titre": "La racine",
      "texte": "La plupart des mots arabes ont trois lettres solides, toujours dans le même ordre : leur racine. كَتَبَ, كَاتِبٌ et كِتَابٌ ont la racine ك ت ب.",
      "exemples": [
        "كَتَبَ",
        "كَاتِبٌ",
        "كِتَابٌ"
      ],
      "question": {
        "type": "qcm",
        "consigne": "Quelle est la racine de كَاتِبٌ ?",
        "choix_ar": [
          "ك ت ب",
          "ك ا ت",
          "ت ب ك"
        ],
        "reponse": 0,
        "explication": "On enlève le ا long : ك ت ب, dans cet ordre."
      }
    },
    {
      "type": "regle",
      "titre": "Trouver la racine",
      "texte": "Enlève l'article, la fin du mot et les voyelles longues ا, و, ي ; parfois aussi un م ou un أ ajouté au début. Il reste la racine : الْمِفْتَاحُ → ف ت ح.",
      "exemples": [
        "الْمِفْتَاحُ",
        "الْأَحْمَالُ",
        "يَكْتُبُونَ"
      ],
      "question": {
        "type": "ordonner",
        "consigne": "Trouve la racine de ce mot : touche ses lettres dans l'ordre.",
        "tuiles": [
          "ل",
          "ح",
          "م",
          "ا"
        ],
        "solution": [
          "ح",
          "م",
          "ل"
        ],
        "explication": "On enlève الـ, le أ ajouté, le ا long et la fin : ح م ل.",
        "ar": "الْأَحْمَالُ"
      }
    },
    {
      "type": "regle",
      "titre": "Attention",
      "texte": "La racine aide à repérer et à retenir les mots d'une famille ; elle ne permet pas de deviner le sens exact de chaque mot. Avec و, ي, ء ou une lettre doublée, la racine se cache parfois (plus tard).",
      "exemples": [
        "ذَهَبَ",
        "ذَهَبٌ"
      ],
      "question": {
        "type": "qcm",
        "consigne": "ذَهَبَ « il est allé » et ذَهَبٌ « l'or » ont la même racine. Que faut-il en conclure ?",
